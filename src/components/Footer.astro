---
import site from '../data/site.json';
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';
import { nav } from '../data/nav';
const year = new Date().getFullYear();
const mail = site.email.startsWith('[') ? '#' : `mailto:${site.email}`;
---
<footer class="site-footer wrap">
  <div class="footer-top">
    <div class="stack" style="gap: 28px">
      <Wordmark large label={`${site.name}, back to home`} />
      <p class="serif" style="font-size: 24px; font-style: italic; line-height: 1.4; max-width: 380px; color: var(--charcoal)">{site.tagline}</p>
    </div>
    <div class="footer-cols">
      <nav aria-label="Footer" class="stack g14">
        <span class="eyebrow sm" style="margin-bottom: 6px">Explore</span>
        {nav.map((n) => <a class="ulink" href={n.href}>{n.label}</a>)}
      </nav>
      <div class="stack g14">
        <span class="eyebrow sm" style="margin-bottom: 6px">Get in touch</span>
        <a class="ulink" href={mail}>{site.email}</a>
        <span>{site.phone}</span>
        <span>{site.address}</span>
        <div class="socials">
          <a class="social" href={site.social.instagram} aria-label={`${site.monogram} on Instagram`}><Icon name="instagram" /></a>
          <a class="social" href={site.social.facebook} aria-label={`${site.monogram} on Facebook`}><Icon name="facebook" /></a>
          <a class="social" href={site.social.tiktok} aria-label={`${site.monogram} on TikTok`}><Icon name="tiktok" /></a>
          <a class="social" href={mail} aria-label={`Email ${site.monogram}`}><Icon name="mail" /></a>
        </div>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {year} {site.name}. All rights reserved.</span>
    <span>{site.domain}</span>
  </div>
</footer>
