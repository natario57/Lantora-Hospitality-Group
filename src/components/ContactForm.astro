---
import site from '../data/site.json';
/** General contact form. Submissions go to Netlify Forms ("contact"). */
interface Props { id?: string; title?: string; rows?: number }
const { id = 'c', title, rows = 4 } = Astro.props;
---
<form class="form" name="contact" method="POST" action="/inquiry/thanks/" data-netlify="true" netlify-honeypot="bot-field" aria-label={title ? undefined : 'Contact form'} aria-labelledby={title ? `${id}-title` : undefined}>
  <input type="hidden" name="form-name" value="contact" />
  <p class="hp"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
  {title && <h2 id={`${id}-title`} class="serif" style="font-size: 36px">{title}</h2>}
  <div class="field-row">
    <div class="field"><label for={`${id}-first`}>First Name</label><input id={`${id}-first`} name="first_name" type="text" autocomplete="given-name" required /></div>
    <div class="field"><label for={`${id}-last`}>Last Name</label><input id={`${id}-last`} name="last_name" type="text" autocomplete="family-name" required /></div>
  </div>
  <div class="field-row">
    <div class="field"><label for={`${id}-email`}>Email</label><input id={`${id}-email`} name="email" type="email" autocomplete="email" required /></div>
    <div class="field"><label for={`${id}-phone`}>Phone</label><input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" /></div>
  </div>
  <div class="field"><label for={`${id}-msg`}>Message / Description</label><textarea id={`${id}-msg`} name="message" rows={rows} required></textarea></div>
  <div class="form-foot">
    <span class="note">Sent directly to the {site.monogram} inbox.</span>
    <button type="submit" class="btn btn-dark">Submit <span class="arrow">→</span></button>
  </div>
</form>
