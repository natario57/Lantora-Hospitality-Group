---
interface Props { name: 'menu' | 'close' | 'prev' | 'next' | 'instagram' | 'facebook' | 'tiktok' | 'mail' | 'back'; size?: number }
const { name, size = 18 } = Astro.props;
---
{name === 'menu' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M3 8h18M3 16h18"/></svg>}
{name === 'close' && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg>}
{name === 'prev' && <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M13.5 5L7.5 11l6 6"/></svg>}
{name === 'next' && <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M8.5 5l6 6-6 6"/></svg>}
{name === 'back' && <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M3 11L11 3M5 3h6v6"/></svg>}
{name === 'instagram' && <svg width={size} height={size} viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="2" y="2" width="14" height="14" rx="4"/><circle cx="9" cy="9" r="3.2"/><circle cx="13.2" cy="4.8" r="0.6" fill="currentColor"/></svg>}
{name === 'facebook' && <svg width={size} height={size} viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M10.5 16V9.5h2.2l.3-2.5h-2.5V5.6c0-.7.2-1.2 1.2-1.2h1.4V2.2A17 17 0 0 0 11 2C9.1 2 7.9 3.2 7.9 5.3V7H5.8v2.5h2.1V16"/></svg>}
{name === 'tiktok' && <svg width={size} height={size} viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M10 2v9.5a2.8 2.8 0 1 1-2.8-2.8M10 2c.3 2 1.8 3.4 4 3.6"/></svg>}
{name === 'mail' && <svg width={size} height={size} viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="2" y="4" width="14" height="10" rx="1"/><path d="M2.5 4.5L9 10l6.5-5.5"/></svg>}
