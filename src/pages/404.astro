---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="wrap stack" style="padding-top: 140px; padding-bottom: 160px; gap: 32px">
    <span class="eyebrow">404</span>
    <h1 class="serif h1">This page has <em>moved on.</em></h1>
    <p class="body" style="max-width: 480px">The page you were looking for isn't here. Let us show you somewhere better.</p>
    <div class="btn-row"><a class="btn btn-dark" href="/">Back to Home</a><a class="btn btn-line" href="/concepts/">Explore Concepts</a></div>
  </section>
</Base>
