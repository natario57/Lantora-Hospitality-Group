---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import site from '../../data/site.json';
---
<Base title="Thank you">
  <section class="wrap grid12 ty" style="align-items: center">
    <div class="stack ty-copy" style="gap: 30px">
      <span class="eyebrow">Message received</span>
      <h1 class="serif" style="font-size: clamp(64px, 9.2vw, 132px); line-height: .92; letter-spacing: -.03em">Thank <em>you.</em></h1>
      <p class="body" style="max-width: 500px">Your note is on its way to the {site.monogram} team. We'll reply by email as soon as we can.</p>
      <div class="stack" style="gap: 6px; padding-top: 24px; border-top: 1px solid var(--beige); max-width: 500px; font-size: 15px; color: var(--muted); line-height: 1.6"><span>Need us sooner? {site.email} · {site.phone}</span></div>
      <div class="btn-row" style="margin-top: 8px"><a class="btn btn-dark" href="/">Back to Home</a><a class="btn btn-line" href="/concepts/">Explore Concepts</a></div>
    </div>
    <div class="ty-images">
      <Photo tone="#C9B69C" class="ty-main" />
      <Photo tone="#E7DDCD" class="ty-inset" />
    </div>
  </section>
</Base>

<style is:global>
  .ty { padding-top: 120px; padding-bottom: 140px; }
  .ty-copy { grid-column: span 6; }
  .ty-images { grid-column: 8 / span 5; position: relative; height: 700px; }
  .ty-main { position: absolute !important; right: 0; top: 0; width: 100%; height: 560px; }
  .ty-inset { position: absolute !important; left: -110px; bottom: 0; width: 240px; height: 300px; border: 12px solid var(--ivory); }
  @media (max-width: 1100px) {
    .ty-copy { grid-column: 1 / span 12; }
    .ty-images { display: none; }
  }
  @media (max-width: 720px) { .ty { padding-top: 72px; padding-bottom: 96px; } }
</style>
