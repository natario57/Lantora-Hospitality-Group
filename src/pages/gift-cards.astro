---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';

const steps = [
  { title: 'Choose an amount', text: 'Visit our gift card page on Toast and select a design and value.' },
  { title: 'Add a message', text: 'Personalise it with a note and send it to someone special.' },
  { title: `Enjoy at ${site.monogram}`, text: `Redeem at [participating ${site.monogram} restaurants — confirm list].` },
];
const faqs = [
  { q: 'Where can gift cards be used?', a: `[List the ${site.monogram} restaurants where gift cards can be redeemed.]` },
  { q: 'How do I check my balance?', a: 'Balances can be checked on our Toast gift card page. [Confirm balance-check link.]' },
  { q: 'Do gift cards expire?', a: '[Expiry and terms.]' },
  { q: 'Can I buy a gift card in person?', a: '[In-person purchase details.]' },
];
---
<Base title="Gift Cards" current="gift" description={`Give the gift of hospitality with a ${site.name} gift card.`}>
  <section aria-labelledby="gc-h" class="gc-hero">
    <div class="gc-stage">
      <div class="gc-under" aria-hidden="true"></div>
      <div class="gc-card" role="img" aria-label={`${site.monogram} gift card`}>
        <div style="display: flex; justify-content: space-between; align-items: flex-start">
          <span class="wordmark on-dark" style="color: var(--ivory)"><span class="mono" style="font-size: 34px">{site.monogram}</span><span class="sub" style="font-size: 10px">{site.wordmarkSub}</span></span>
          <span class="eyebrow" style="font-size: 10.5px; color: rgba(250,247,242,.7)">Gift Card</span>
        </div>
        <span class="serif" style="font-size: clamp(20px, 2.1vw, 30px); font-style: italic">The gift of hospitality.</span>
      </div>
    </div>
    <div class="stack gc-copy" style="gap: 34px; justify-content: center">
      <span class="eyebrow">{site.monogram} — Gift Cards</span>
      <h1 id="gc-h" class="serif" style="font-size: clamp(52px, 7.2vw, 104px); line-height: .96; letter-spacing: -.025em">Give the Gift of <em>Hospitality.</em></h1>
      <p class="body" style="max-width: 480px">Share memorable dining experiences with someone special.</p>
      <div class="stack g14" style="align-items: flex-start">
        <a class="btn btn-dark" href={site.giftCardUrl} target="_blank" rel="noopener noreferrer">Purchase a Gift Card <span class="arrow">↗</span></a>
        <span class="note">You'll complete your purchase securely on Toast, in a new tab.</span>
      </div>
    </div>
  </section>

  <section aria-labelledby="how-h" class="wrap stack" style="padding-top: 160px; padding-bottom: 160px; gap: 64px">
    <div class="stack g24"><span class="eyebrow">01 — How It Works</span><h2 id="how-h" class="serif h3">Three simple <em>steps.</em></h2></div>
    <ol class="cols-3" style="list-style: none; margin: 0; padding: 0">
      {steps.map((s, k) => (
        <li class="stack" style="border-top: 1px solid var(--black); padding-top: 32px; gap: 16px"><span class="serif" style="font-size: 48px; color: var(--muted)">{String(k + 1).padStart(2, '0')}</span><h3 class="serif h6">{s.title}</h3><p class="body-sm">{s.text}</p></li>
      ))}
    </ol>
  </section>

  <section aria-label="Perfect for" class="wrap bg-cream stack" style="padding-top: 110px; padding-bottom: 110px; align-items: center; gap: 36px; text-align: center">
    <span class="eyebrow">Perfect for</span>
    <p class="serif" style="font-size: clamp(34px, 4.4vw, 64px); line-height: 1.2; letter-spacing: -.01em">Birthdays · Anniversaries · <em>Holidays</em> · Thank-yous · Just because</p>
  </section>

  <section aria-labelledby="faq-h" class="wrap grid12" style="padding-top: 160px; padding-bottom: 160px">
    <div class="stack g24 faq-head"><span class="eyebrow">02 — Questions</span><h2 id="faq-h" class="serif" style="font-size: clamp(44px, 5vw, 72px); line-height: 1; letter-spacing: -.02em">Good to <em>know.</em></h2></div>
    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq">
          <summary><span>{f.q}</span><span class="pm" aria-hidden="true">+</span></summary>
          <p class="body-sm">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section aria-labelledby="corp-h" class="gc-corp on-dark">
    <div class="stack" style="gap: 18px; max-width: 700px">
      <span class="eyebrow" style="color: rgba(250,247,242,.7)">Corporate &amp; Bulk Gifting</span>
      <h2 id="corp-h" class="serif" style="font-size: clamp(36px, 3.9vw, 56px); line-height: 1.05">Gifting for your team or clients?</h2>
      <p style="font-size: 17px; line-height: 1.7; color: rgba(250,247,242,.82)">Send us a note and we'll help with larger orders.</p>
    </div>
    <a class="btn btn-light" href="/inquiry/">Get in Touch</a>
  </section>
</Base>

<style is:global>
  .gc-hero { padding: var(--edge) var(--edge) 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); min-height: 860px; }
  .gc-stage { background: var(--beige); position: relative; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .gc-under { position: absolute; width: 480px; max-width: 75%; aspect-ratio: 480 / 300; background: var(--sand); transform: rotate(-8deg) translate(-50px, 36px); }
  .gc-card { position: relative; width: 500px; max-width: 82%; aspect-ratio: 500 / 314; background: var(--black); color: var(--ivory); padding: clamp(20px, 2.6vw, 38px) clamp(22px, 2.8vw, 40px); display: flex; flex-direction: column; justify-content: space-between; box-shadow: 0 40px 70px -34px rgba(21,20,18,.5); transform: rotate(3deg); }
  .gc-copy { padding: 100px var(--gutter) 100px 96px; }
  .faq-head { grid-column: span 4; }
  .faq-list { grid-column: 6 / span 7; border-top: 1px solid var(--sand); }
  .faq { border-bottom: 1px solid var(--sand); }
  .faq summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 30px 0; cursor: pointer; font: 400 clamp(22px, 2.1vw, 30px)/1.2 var(--serif); }
  .faq summary::-webkit-details-marker { display: none; }
  .faq .pm { font: 300 28px/1 var(--sans); transition: transform .4s; }
  .faq[open] .pm { transform: rotate(45deg); }
  .faq p { padding: 0 60px 30px 0; animation: fadein .6s ease both; }
  .gc-corp { margin: 0 var(--gutter) 160px; padding: 88px 96px; background: var(--black); color: var(--ivory); display: flex; justify-content: space-between; align-items: center; gap: 48px; }
  @media (max-width: 1100px) {
    .gc-hero { grid-template-columns: minmax(0, 1fr); min-height: 0; }
    .gc-stage { height: 520px; }
    .gc-copy { padding: 80px var(--gutter); }
    .faq-head, .faq-list { grid-column: 1 / span 12; }
    .faq-list { margin-top: 48px; }
    .gc-corp { flex-direction: column; align-items: flex-start; padding: 64px 40px; }
  }
  @media (max-width: 720px) {
    .gc-stage { height: 360px; }
    .gc-copy { padding: 64px 20px; }
    .faq-list { margin-top: 0; }
    .faq p { padding-right: 0; }
    .gc-corp { margin-bottom: 96px; padding: 48px 24px; }
  }
</style>
